{
  "name": "myomivela",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "node server.mjs",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "build:site": "node scripts/build-site.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:worker": "MYO_TARGET=worker node --test --test-concurrency=1 tests/*.test.mjs",
    "test:browser": "node --no-warnings tests/browser/portal-smoke.mjs && node --no-warnings tests/browser/holds-smoke.mjs && node --no-warnings tests/browser/booking-form-smoke.mjs",
    "backup": "node scripts/backup.mjs",
    "build": "tailwindcss -c docs/archive/design-previews/tailwind.config.cjs -i docs/archive/design-previews/assets/legacy-tailwind.input.css -o docs/archive/design-previews/assets/legacy-tailwind.css --minify"
  },
  "devDependencies": {
    "@tailwindcss/container-queries": "0.1.1",
    "@tailwindcss/forms": "0.5.11",
    "tailwindcss": "3.4.19",
    "wrangler": "^4.164.0"
  }
}
